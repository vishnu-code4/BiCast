# ============================================================
# BiCAST Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----- Server -----------------------------------------------
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ----- Database ---------------------------------------------
# PostgreSQL connection string (Prisma format)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bicast_db?schema=public"

# ----- Google APIs (optional — fallback providers are used without keys) ----
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# ----- Routing provider -------------------------------------
# Options: osrm (default, free), google
ROUTING_PROVIDER=osrm

# OSRM public demo server (replace with self-hosted for production)
OSRM_BASE_URL=https://router.project-osrm.org

# ----- Weather provider -------------------------------------
# Options: openmeteo (default, free), openweathermap
WEATHER_PROVIDER=openmeteo
OPENWEATHERMAP_API_KEY=

# ----- Geocoding provider -----------------------------------
# Options: nominatim (default, free), google
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ----- Places provider --------------------------------------
# Options: overpass (default, free), google
PLACES_PROVIDER=overpass
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# ----- Rate limiting ----------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ----- JWT (for future auth) --------------------------------
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d
